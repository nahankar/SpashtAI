# Copy to infra/cube/.env and fill in. Never commit .env.
# docker compose reads this directory's .env for the ${VAR} substitutions
# in docker-compose.yml.

# PostgreSQL URL for the existing SpashtAI database.
# Use a role that has SELECT only. Cube also sets
# default_transaction_read_only=on for the session.
# localhost and 127.0.0.1 are rewritten to host.docker.internal inside
# this compose service. sslmode=require encrypts without verifying the CA;
# use verify-full when the server certificate should be checked.
DATABASE_URL=postgresql://cube_reader:password@localhost:5432/spashtai

# HS256 secret for API JWTs. Use a long random value.
CUBEJS_API_SECRET=replace-with-a-long-random-secret

# Locks. docker-compose.yml sets the same values on the container.
# Leave CUBEJS_PG_SQL_PORT unset. Setting it turns the SQL API on, and
# this service refuses to start if that variable is present.
CUBEJS_DEV_MODE=false
CUBEJS_CACHE_AND_QUEUE_DRIVER=memory
CUBEJS_DB_TYPE=postgres
CUBEJS_TELEMETRY=false
CUBEJS_DB_MAX_POOL=4
CUBEJS_DB_QUERY_TIMEOUT=60
CUBEJS_LOG_LEVEL=info

# Optional when the URL has no sslmode and the server requires TLS.
# CUBEJS_DB_SSL=true
# CUBEJS_DB_SSL_REJECT_UNAUTHORIZED=false
