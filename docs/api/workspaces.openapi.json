    "/api/workspaces/entry/{slug}": {
      "post": {
        "summary": "Resolve workspace entry and issue a workspace token only for active membership",
        "description": "Invited membership returns accessToken=null; active token expires after 900 seconds. Slug never grants membership. Placement is resolved on the server.",
