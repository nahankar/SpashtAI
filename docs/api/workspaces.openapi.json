      "get": {
        "summary": "List/count only current organization invitations (20 per page)",
        "description": "Active workspace Owner/Admin required. Admin may grant/manage LEARNER only; Owner may grant all workspace roles. No platform role changes. SMTP runs after commit. New identities respect paused public signups.",
        "security": [
          {
            "workspace": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "accepted",
                "expired",
                "revoked"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1
            }
          }
        ],
        "responses": {
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "503": {
            "$ref": "#/components/responses/503"
          },
          "200": {
            "description": "Workspace-only invitation or paginated items/counts. No acceptance token is returned.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Invite a verified Google identity to this workspace",
        "description": "Active workspace Owner/Admin required. Admin may grant/manage LEARNER only; Owner may grant all workspace roles. No platform role changes. SMTP runs after commit. New identities respect paused public signups.",
        "security": [
          {
            "workspace": []
          }
        ],
        "parameters": [],
        "responses": {
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "409": {
            "$ref": "#/components/responses/409"
          },
          "503": {
            "$ref": "#/components/responses/503"
          },
          "200": {
            "description": "Workspace-only invitation or paginated items/counts. No acceptance token is returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceInvitation"
                }
              }
            }
          },
          "429": {
            "description": "Send budget exceeded (60 per identity per hour in production)"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkspaceInvitationInput"
              }
            }
          }
        }
      }
    },
    "/api/workspaces/current/invitations/{id}/resend": {
