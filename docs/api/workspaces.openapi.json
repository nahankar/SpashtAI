  },
  "components": {
    "securitySchemes": {
      "identity": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Identity JWT"
      },
      "workspace": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Workspace JWT (workspace-api audience, 15 minutes)"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "code"
        ]
      },
      "Branding": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "timeZone": {
            "type": "string",
            "example": "Asia/Kolkata"
          },
          "accentColor": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "logoDataUrl": {
            "type": "string",
            "nullable": true,
            "maxLength": 90000,
            "description": "Inline PNG/JPEG/WebP with verified magic bytes; decoded maximum 64 KB."
          }
        },
        "required": []
      },
      "Limits": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maxMembers": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "dailyEvaluations": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "concurrentVoice": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": [
          "maxMembers",
          "dailyEvaluations",
          "concurrentVoice"
        ]
      },
      "FeatureSettings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "memberDefault": {
            "type": "boolean"
          }
        },
        "required": [
          "enabled",
          "memberDefault"
        ]
      },
      "Entitlement": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entitled": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "memberDefault": {
            "type": "boolean"
          }
        },
        "required": [
          "entitled",
          "enabled",
          "memberDefault"
        ]
      },
      "MemberChange": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "LEARNER"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED"
            ]
          }
        },
        "required": [],
        "anyOf": [
          {
            "required": [
              "role"
            ]
          },
          {
            "required": [
              "state"
            ]
          }
        ]
      },
      "ExistingMember": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "LEARNER"
            ]
          }
        },
        "required": [
          "email",
          "role"
        ]
      },
      "MemberFeature": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "allowed": {
            "type": "boolean",
            "nullable": true
          }
        },
        "required": [
          "allowed"
        ]
      },
      "CreateOrganization": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "timeZone": {
            "type": "string",
            "example": "Asia/Kolkata"
          },
          "accentColor": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "logoDataUrl": {
            "type": "string",
            "nullable": true,
            "maxLength": 90000,
            "description": "Inline PNG/JPEG/WebP with verified magic bytes; decoded maximum 64 KB."
          },
          "slug": {
            "type": "string",
            "minLength": 3,
            "maxLength": 48,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "ownerEmail": {
            "type": "string",
            "format": "email"
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          }
        },
        "required": [
          "name",
          "slug",
          "ownerEmail"
        ]
      },
      "PlatformSettings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "timeZone": {
            "type": "string",
            "example": "Asia/Kolkata"
          },
          "accentColor": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "logoDataUrl": {
            "type": "string",
            "nullable": true,
            "maxLength": 90000,
            "description": "Inline PNG/JPEG/WebP with verified magic bytes; decoded maximum 64 KB."
          },
          "state": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED"
            ]
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          }
        },
        "required": []
      },
      "ArchiveSession": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "module": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "endedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "durationSeconds": {
            "type": "integer",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "module",
          "purpose",
          "startedAt",
          "endedAt",
          "durationSeconds"
        ]
      },
      "ArchiveRecording": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "duration": {
            "type": "integer"
          },
          "recordingType": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "duration",
          "recordingType",
          "status"
        ]
      },
      "ArchiveMessage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string",
            "nullable": true
          },
          "content": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "role",
          "content",
          "timestamp"
        ]
      },
      "ArchiveList": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArchiveSession"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "ArchiveDetail": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "session": {
            "$ref": "#/components/schemas/ArchiveSession"
          },
          "recordings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArchiveRecording"
            }
          }
        },
        "required": [
          "session",
          "recordings"
        ]
      },
      "ArchiveTranscript": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArchiveMessage"
            }
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "messages",
          "updatedAt"
        ]
      },
      "WorkspaceInvitationInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "LEARNER"
            ],
            "default": "LEARNER"
          },
          "memberFeatures": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            },
            "description": "Optional feature-catalog overrides constrained by workspace entitlements."
          }
        }
      },
      "WorkspaceInvitation": {
        "type": "object",
        "description": "Safe invitation fields only; excludes tokenHash, pendingKey and inviter identity.",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "LEARNER"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "expired",
              "revoked"
            ]
          },
          "deliveryStatus": {
            "type": "string",
            "enum": [
              "SENDING",
              "SENT",
              "FAILED",
              "DEV_CAPTURED"
            ]
          },
          "memberFeatures": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "responses": {
      "400": {
        "description": "Invalid settings",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "401": {
        "description": "Wrong, invalid or expired token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "403": {
        "description": "Current role, membership or entitlement does not permit this action",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "404": {
        "description": "Disabled rollout or unavailable workspace/member",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "409": {
        "description": "Conflict, seat limit, acceptance or last active Owner constraint",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "503": {
        "description": "Unsafe database role, missing row isolation or unavailable placement",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
