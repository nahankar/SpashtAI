    "title": "SpashtAI workspace foundation",
    "version": "0.1.0",
    "description": "Local contract. Feature flag WORKSPACES_ENABLED defaults false. This is control-plane administration only, not tenant product readiness. Workspace JWTs cannot authorize legacy Personal/Admin APIs."
  },
