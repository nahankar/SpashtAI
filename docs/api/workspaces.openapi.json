  "components": {
    "securitySchemes": {
      "identity": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Identity JWT"
      },
      "workspace": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Workspace JWT (workspace-api audience, 15 minutes)"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "code"
        ]
      },
      "Branding": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "timeZone": {
            "type": "string",
            "example": "Asia/Kolkata"
          },
          "accentColor": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "logoDataUrl": {
            "type": "string",
            "nullable": true,
            "maxLength": 90000,
            "description": "Inline PNG/JPEG/WebP with verified magic bytes; decoded maximum 64 KB."
          }
        },
        "required": []
      },
      "Limits": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maxMembers": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "dailyEvaluations": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "concurrentVoice": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": [
          "maxMembers",
          "dailyEvaluations",
          "concurrentVoice"
        ]
      },
      "FeatureSettings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "memberDefault": {
            "type": "boolean"
          }
        },
        "required": [
          "enabled",
          "memberDefault"
        ]
      },
      "Entitlement": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entitled": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "memberDefault": {
            "type": "boolean"
          }
        },
        "required": [
          "entitled",
          "enabled",
          "memberDefault"
        ]
      },
      "MemberChange": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "LEARNER"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED"
            ]
          }
        },
        "required": [],
        "anyOf": [
          {
            "required": [
              "role"
            ]
          },
          {
            "required": [
              "state"
            ]
          }
        ]
      },
      "ExistingMember": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "ADMIN",
              "LEARNER"
            ]
          }
        },
        "required": [
          "email",
          "role"
        ]
      },
      "MemberFeature": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "allowed": {
            "type": "boolean",
            "nullable": true
          }
        },
        "required": [
          "allowed"
        ]
      },
      "CreateOrganization": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "timeZone": {
            "type": "string",
            "example": "Asia/Kolkata"
          },
          "accentColor": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "logoDataUrl": {
            "type": "string",
            "nullable": true,
            "maxLength": 90000,
            "description": "Inline PNG/JPEG/WebP with verified magic bytes; decoded maximum 64 KB."
          },
          "slug": {
            "type": "string",
            "minLength": 3,
            "maxLength": 48,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "ownerEmail": {
            "type": "string",
            "format": "email"
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          }
        },
        "required": [
          "name",
          "slug",
          "ownerEmail"
        ]
      },
      "PlatformSettings": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "timeZone": {
            "type": "string",
            "example": "Asia/Kolkata"
          },
          "accentColor": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "logoDataUrl": {
            "type": "string",
            "nullable": true,
            "maxLength": 90000,
            "description": "Inline PNG/JPEG/WebP with verified magic bytes; decoded maximum 64 KB."
          },
          "state": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SUSPENDED"
            ]
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          }
        },
        "required": []
      }
    },
    "responses": {
      "400": {
        "description": "Invalid settings",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "401": {
        "description": "Wrong, invalid or expired token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
