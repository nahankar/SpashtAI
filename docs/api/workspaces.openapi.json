    "/api/workspaces/current/sessions": {
      "get": {
        "summary": "List own workspace sessions in stable ID order (50 per page)",
        "description": "Requires active organization membership and both rollout gates. Owner/Admin cannot read another learner's raw content. Workspace bearer token must be in Authorization, never the URL.",
        "security": [
          {
            "workspace": []
          }
        ],
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 160
            },
            "description": "Previous response nextCursor; null means no further page."
          }
        ],
        "responses": {
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "503": {
            "$ref": "#/components/responses/503"
          },
          "410": {
            "description": "Owned session was discarded"
          },
          "200": {
            "description": "Safe archive DTO; no provider or storage identifiers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArchiveList"
                }
              }
            }
          }
        }
      }
    },
