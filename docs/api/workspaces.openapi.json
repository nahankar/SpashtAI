    "/api/workspaces/current/sessions/{sessionId}/recordings/{recordingId}/stream": {
      "get": {
        "summary": "Stream own namespaced local recording with header authentication",
        "description": "Requires active organization membership and both rollout gates. Owner/Admin cannot read another learner's raw content. Workspace bearer token must be in Authorization, never the URL.",
        "security": [
          {
            "workspace": []
          }
        ],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 160
            }
          },
          {
            "name": "recordingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 160
            }
          },
          {
            "name": "Range",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "One bytes range; suffix and open-ended ranges supported."
          }
        ],
        "responses": {
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "503": {
            "$ref": "#/components/responses/503"
          },
          "410": {
            "description": "Owned session was discarded"
          },
          "200": {
            "description": "Private no-store recording bytes; Content-Type reflects the allowed media extension",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "206": {
            "description": "Private no-store recording bytes; Content-Type reflects the allowed media extension",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "416": {
            "description": "Invalid or unsatisfiable byte range; Content-Range includes complete size"
          }
        }
      }
    },
