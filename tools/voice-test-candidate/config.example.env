# Copy to .env.local (git-ignored) and fill in. Placeholders only — never commit real values.

# Dedicated fictional test account (password sign-in through the app's /auth/admin form)
VTC_EMAIL=voice.candidate.local@example.com
VTC_PASSWORD=<choose-a-local-password>

# Target (defaults to local development). Production hosts additionally require --allow-production.
# VTC_TARGET_URL=http://localhost:5173
# VTC_AUTH_FILE=.auth/localhost_5173.json
# VTC_PRODUCTION_HOSTS=extra-prod-host.example
# VTC_NONPRODUCTION_HOSTS=staging.spasht.ai

# Listening: OpenAI-compatible /audio/transcriptions (default: local speaches/faster-whisper container)
VTC_STT_PROVIDER=openai-compatible
VTC_STT_BASE_URL=http://localhost:8001/v1
VTC_STT_MODEL=Systran/faster-distil-whisper-small.en
VTC_STT_API_KEY=local
VTC_STT_MAX_REQUESTS=400

# Candidate replies: OpenAI-compatible /chat/completions (default: local Ollama) or `scripted` (provider-free)
VTC_LLM_PROVIDER=openai-compatible
VTC_LLM_BASE_URL=http://localhost:11434/v1
VTC_LLM_MODEL=gemma4:12b
VTC_LLM_API_KEY=local
VTC_LLM_REASONING_EFFORT=none
VTC_LLM_MAX_REQUESTS=60

# Speaking: OpenAI-compatible /audio/speech (default: local Kokoro container) or `macos-say`
VTC_TTS_PROVIDER=openai-compatible
VTC_TTS_BASE_URL=http://localhost:8002/v1
VTC_TTS_MODEL=kokoro
VTC_TTS_VOICE=am_michael
VTC_TTS_API_KEY=local
VTC_TTS_MAX_REQUESTS=200

# Repeatable workflow launcher (all endpoints should be this checkout's local stack).
# VTC_API_URL=http://localhost:4100
# VTC_LIVEKIT_URL=ws://localhost:7980
# VTC_WORKSPACE=northwind             # omit for Personal
# VTC_API_LOG=/absolute/path/to/api.log
# VTC_AGENT_LOG=/absolute/path/to/agent.log
