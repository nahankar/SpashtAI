# API (production: https://api.spasht.ai)
VITE_API_BASE_URL=http://localhost:4000

# Google Sign-In — must match server GOOGLE_CLIENT_ID (GIS Web Client ID)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Optional: product analytics (PostHog, Plausible, etc.) — not wired yet
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Mic capture constraints for Elevate. All default to true (same as LiveKit's own
# defaults). Set 'false' to disable — mainly to check how much auto gain control
# suppresses the loudness variation that prosody energy stability scores.
# VITE_AUDIO_ECHO_CANCELLATION=false
# VITE_AUDIO_NOISE_SUPPRESSION=false
# VITE_AUDIO_AUTO_GAIN_CONTROL=false
# VITE_AUDIO_VOICE_ISOLATION=false

# Browser remote logging → /api/client-logs → S3 (operational, optional).
# Unset = ship only in production builds. Set 'false' to disable entirely,
# 'true' to also ship from dev builds. Server must also set CLIENT_LOGS_ENABLED=true.
# VITE_CLIENT_LOGS_ENABLED=false
